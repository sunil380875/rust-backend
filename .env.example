# Server
PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=rust_backend

# JWT (generate a strong secret: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_strong_random_secret

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Logging (trace | debug | info | warn | error)
RUST_LOG=info,rust_backend=debug
